#!/usr/bin/env sh
# Convenience wrapper: runs a tanuki command inside the running container.
#
#   ./tanuki add example.com   ==  docker compose exec tanuki /tanuki add example.com
#
# With the proxy stopped it runs a one-off container instead, so the CLI still
# works and a stale proxy redirect can be cleared with "./tanuki reset".
set -eu

COMPOSE="docker compose"
if ! docker compose version >/dev/null 2>&1; then
	if command -v docker-compose >/dev/null 2>&1; then
		COMPOSE="docker-compose"
	else
		echo "tanuki: docker compose not found, install Docker first" >&2
		exit 1
	fi
fi

# With the proxy running, exec into it. With it stopped, fall back to a one-off
# container from the same service definition: same image, same mounts, so the
# CLI still works and -- the reason this matters -- a redirect left in
# .claude/settings.json by a kill the proxy could not catch (docker kill, the
# OOM killer, a host crash) can still be cleared with "./tanuki reset". Without
# this the only way out is to start the proxy just to stop it again, which the
# ECONNREFUSED that Claude Code reports does not hint at.
if [ "$($COMPOSE ps -q tanuki 2>/dev/null)" != "" ]; then
	exec $COMPOSE exec -T tanuki /tanuki "$@"
fi

if [ -f .claude/settings.json ] && grep -q ANTHROPIC_BASE_URL .claude/settings.json 2>/dev/null; then
	echo "tanuki: the proxy is not running, but .claude/settings.json still points" >&2
	echo "tanuki: Claude Code at it. Clear it with: ./tanuki reset" >&2
fi

exec $COMPOSE run --rm -T tanuki "$@"
