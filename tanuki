#!/usr/bin/env sh
# Convenience wrapper: runs a tanuki command inside the running container.
#
#   ./tanuki add example.com   ==  docker compose exec tanuki /tanuki add example.com
set -eu

COMPOSE="docker compose"
if ! docker compose version >/dev/null 2>&1; then
	if command -v docker-compose >/dev/null 2>&1; then
		COMPOSE="docker-compose"
	else
		echo "tanuki: docker compose not found, install Docker first" >&2
		exit 1
	fi
fi

if [ "$($COMPOSE ps -q tanuki 2>/dev/null)" = "" ]; then
	echo "tanuki: container is not running, start it with: $COMPOSE up -d" >&2
	# The proxy points Claude Code at itself while it runs and undoes that on
	# shutdown. A kill it cannot catch (docker kill, the OOM killer, a host
	# crash) leaves the redirect behind, and Claude Code then fails with
	# ECONNREFUSED in this directory until it is removed.
	if [ -f .claude/settings.json ] && grep -q ANTHROPIC_BASE_URL .claude/settings.json 2>/dev/null; then
		echo "tanuki: .claude/settings.json still points Claude Code at the proxy." >&2
		echo "tanuki: clear it with: $COMPOSE up -d && $COMPOSE down" >&2
	fi
	exit 1
fi

exec $COMPOSE exec -T tanuki /tanuki "$@"
